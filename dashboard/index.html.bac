<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
<meta http-equiv="Pragma" content="no-cache">
<meta http-equiv="Expires" content="0">
<title>Dadinkowa HPP - Real Time Generation Board</title>

<style>
:root{
    --navy:#062650;
    --navy-dark:#031b3b;
    --red:#d92b2b;
    --green:#3ea63f;
    --orange:#d88a00;
    --white:#fff;
    --border:#c7d3e1;
    --text:#092850;
    --light:#f8fafc;
}

*{box-sizing:border-box}

html,body{
    width:100%;
    height:100%;
    margin:0;
}

body{
    font-family:"Arial Narrow","Roboto Condensed","Helvetica Neue",Arial,sans-serif;
    background:var(--white);
    color:var(--text);
    overflow:hidden;
}

.board{
    width:100vw;
    height:100vh;
    display:grid;
    grid-template-rows:19% 28% 19% 24% 10%;
    background:#fff;
}

/* ================= HEADER ================= */

.header{
    display:grid;
    grid-template-columns:24% 52% 24%;
    align-items:center;
    padding:1vh 1.5vw;
}

.brand{
    height:100%;
    display:flex;
    align-items:center;
    gap:1.2vw;
    padding-left:1vw;
}

.brand img{
    width:clamp(130px,12vw,205px);
    max-height:120px;
    object-fit:contain;
}

.brand-divider{
    width:2px;
    height:72%;
    background:#8d9aaa;
}

.title{
    text-align:center;
}

.title h1{
    margin:0;
    color:var(--navy);
    font-family:"Arial Narrow","Roboto Condensed",Arial,sans-serif;
    font-size:clamp(45px,5.25vw,86px);
    line-height:.82;
    font-weight:1000;
    letter-spacing:-1.5px;
    transform:scaleY(1.12);
}

.title .subtitle{
    margin-top:2vh;
    display:flex;
    align-items:center;
    justify-content:center;
    gap:1vw;
    color:var(--red);
    font-size:clamp(18px,2.05vw,34px);
    font-weight:1000;
    letter-spacing:.5px;
}

.subtitle:before,
.subtitle:after{
    content:"";
    width:6vw;
    max-width:95px;
    height:3px;
    background:var(--red);
}

.clock{
    justify-self:end;
    width:min(19vw,300px);
    min-width:220px;
    border:1px solid var(--border);
    border-radius:10px;
    overflow:hidden;
}

.clock-title{
    background:var(--navy);
    color:white;
    text-align:center;
    font-size:clamp(17px,1.55vw,26px);
    font-weight:900;
    padding:1vh .5vw;
}

.clock-date{
    text-align:center;
    font-size:clamp(19px,1.75vw,29px);
    font-weight:800;
    padding-top:1vh;
}

.clock-time{
    text-align:center;
    color:var(--red);
    font-size:clamp(21px,2vw,33px);
    font-weight:1000;
    padding:.6vh 0 1.2vh;
}

/* ================= UNIT SECTION ================= */

.unit-section{
    margin:0 1vw;
    border:1px solid var(--border);
    border-radius:9px;
    overflow:hidden;
}

.section-title{
    height:20%;
    min-height:48px;
    background:var(--navy);
    color:white;
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:clamp(24px,2.05vw,35px);
    font-weight:1000;
    letter-spacing:.3px;
}

.units{
    height:80%;
    display:grid;
    grid-template-columns:1fr 1fr;
}

.unit{
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    border-right:1px solid var(--border);
}

.unit:last-child{border-right:0}

.unit-name{
    font-size:clamp(25px,2.2vw,39px);
    font-weight:1000;
    letter-spacing:.2px;
    margin-bottom:1.2vh;
}

.unit-value-box{
    width:48%;
    min-width:300px;
    height:62%;
    min-height:100px;
    max-height:155px;
    background:linear-gradient(135deg,#031d42,#082e60);
    border-radius:8px;
    display:flex;
    align-items:center;
    justify-content:center;
    box-shadow:inset 0 0 0 1px rgba(255,255,255,.04);
}

.unit-value{
    color:white;
    font-family:"Arial Narrow","Roboto Condensed",Arial,sans-serif;
    font-size:clamp(68px,6.6vw,112px);
    line-height:.8;
    font-weight:1000;
    letter-spacing:-2px;
    transform:scaleY(1.15);
}

.unit-value .mw{
    font-size:.31em;
    margin-left:.08em;
    letter-spacing:0;
}

/* ================= SUMMARY ================= */

.summary{
    margin:1.1vh 1vw 0;
    border:1px solid var(--border);
    border-radius:9px;
    display:grid;
    grid-template-columns:1fr 1fr;
}

.summary-card{
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    border-right:1px solid var(--border);
}

.summary-card:last-child{border-right:0}

.summary-label{
    font-size:clamp(19px,1.7vw,29px);
    font-weight:1000;
    margin-bottom:.8vh;
    text-align:center;
}

.summary-value{
    color:var(--red);
    font-family:"Arial Narrow","Roboto Condensed",Arial,sans-serif;
    font-size:clamp(72px,7vw,120px);
    line-height:.78;
    font-weight:1000;
    letter-spacing:-2px;
    transform:scaleY(1.12);
}

.summary-unit{
    font-size:.32em;
    margin-left:.08em;
    letter-spacing:0;
}

/* ================= METRICS ================= */

.metrics{
    margin:1.2vh 1vw 1.1vh;
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:.65vw;
}

.metric{
    border:1px solid var(--border);
    border-radius:8px;
    background:#fff;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    padding:.7vh .5vw;
}

.metric-label{
    text-align:center;
    font-size:clamp(16px,1.42vw,25px);
    font-weight:1000;
    margin-bottom:1.2vh;
}

.metric-value{
    font-family:"Arial Narrow","Roboto Condensed",Arial,sans-serif;
    font-size:clamp(34px,3.05vw,52px);
    font-weight:1000;
    line-height:.9;
    transform:scaleY(1.08);
    white-space:nowrap;
}

/* Water/Dam icon */
.dam-icon{
    width:75px;
    height:58px;
    position:relative;
    margin-top:1vh;
}

.dam-icon .top{
    position:absolute;
    left:10px;
    right:10px;
    top:7px;
    height:12px;
    background:var(--navy);
    border-radius:2px;
}

.dam-icon .body{
    position:absolute;
    left:18px;
    right:18px;
    top:17px;
    bottom:10px;
    background:var(--navy);
    clip-path:polygon(10% 0,90% 0,100% 100%,0 100%);
}

.dam-icon .water{
    position:absolute;
    left:0;
    right:0;
    bottom:0;
    height:9px;
    border-top:4px solid var(--navy);
    border-radius:50%;
}

/* Grid frequency: frequency bars instead of sine wave */
.frequency-icon{
    width:82px;
    height:56px;
    margin-top:1vh;
    display:flex;
    align-items:flex-end;
    justify-content:center;
    gap:5px;
}

.frequency-icon span{
    width:7px;
    background:var(--navy);
    border-radius:2px 2px 0 0;
}

.frequency-icon span:nth-child(1){height:18px}
.frequency-icon span:nth-child(2){height:30px}
.frequency-icon span:nth-child(3){height:44px}
.frequency-icon span:nth-child(4){height:32px}
.frequency-icon span:nth-child(5){height:48px}
.frequency-icon span:nth-child(6){height:34px}
.frequency-icon span:nth-child(7){height:22px}

/* Voltage: electrical outlet/grid symbol */
.voltage-icon{
    width:70px;
    height:62px;
    margin-top:1vh;
    position:relative;
}

.voltage-icon .circle{
    position:absolute;
    width:43px;
    height:43px;
    border:4px solid var(--navy);
    border-radius:50%;
    left:13px;
    top:4px;
}

.voltage-icon .line1,
.voltage-icon .line2,
.voltage-icon .line3{
    position:absolute;
    background:var(--navy);
    height:4px;
    border-radius:3px;
}

.voltage-icon .line1{width:26px;left:22px;top:25px}
.voltage-icon .line2{width:18px;left:26px;top:17px;transform:rotate(90deg)}
.voltage-icon .line3{width:18px;left:26px;top:33px;transform:rotate(90deg)}

.voltage-icon:after{
    content:"";
    position:absolute;
    width:4px;
    height:17px;
    background:var(--navy);
    left:33px;
    bottom:0;
}

/* Status */
.status{
    font-family:"Arial Narrow","Roboto Condensed",Arial,sans-serif;
    font-size:clamp(31px,3.1vw,53px);
    line-height:.9;
    font-weight:1000;
    transform:scaleY(1.08);
}

.status.normal{color:var(--green)}
.status.warning{color:var(--orange)}
.status.danger{color:var(--red)}

.status-icon{
    width:clamp(45px,4.2vw,70px);
    height:clamp(45px,4.2vw,70px);
    margin-top:1.1vh;
    border:5px solid currentColor;
    border-radius:50%;
    position:relative;
}

.status-icon:after{
    content:"";
    position:absolute;
    width:30%;
    height:52%;
    left:34%;
    top:13%;
    border-right:5px solid currentColor;
    border-bottom:5px solid currentColor;
    transform:rotate(42deg);
}

/* ================= FOOTER ================= */

.footer{
    background:var(--navy);
    color:white;
    display:grid;
    grid-template-columns:1fr 1fr 1fr;
    align-items:center;
    padding:0 3vw;
}

.footer-item{
    display:flex;
    justify-content:center;
    align-items:center;
    gap:.9vw;
    font-size:clamp(16px,1.5vw,26px);
    font-weight:1000;
    white-space:nowrap;
}

.footer-item + .footer-item{
    border-left:1px solid rgba(255,255,255,.55);
}

.footer-online{color:#55c955}
.footer-alert{color:#ff7070}

/* ================= OFFLINE OVERLAY ================= */

.offline-banner{
    position:fixed;
    inset:0;
    z-index:100;
    display:none;
    align-items:center;
    justify-content:center;
    background:rgba(110,0,0,.76);
    backdrop-filter:blur(3px);
}

.offline-banner.visible{display:flex}

.offline-card{
    width:min(650px,80vw);
    background:white;
    border:5px solid var(--red);
    border-radius:15px;
    padding:4vh 4vw;
    text-align:center;
    box-shadow:0 15px 50px rgba(0,0,0,.35);
}

.offline-card h2{
    margin:0;
    color:var(--red);
    font-size:clamp(34px,4vw,60px);
    font-weight:1000;
}

.offline-card p{
    font-size:clamp(18px,1.7vw,28px);
    font-weight:600;
}

/* ================= RESPONSIVE ================= */

@media(max-width:900px){
    body{overflow:auto}
    .board{
        min-height:100vh;
        height:auto;
        grid-template-rows:auto auto auto auto auto;
    }
    .header{
        grid-template-columns:1fr;
        gap:1.5vh;
        padding:2vh 2vw;
    }
    .brand{justify-content:center}
    .brand-divider{display:none}
    .clock{justify-self:center;width:60%}
    .unit-section,.summary,.metrics{
        margin-left:2vw;
        margin-right:2vw;
    }
    .unit-value-box{
        min-width:0;
        width:68%;
    }
    .metrics{grid-template-columns:1fr 1fr}
    .footer{
        grid-template-columns:1fr;
        gap:1vh;
        padding:2vh;
    }
    .footer-item + .footer-item{border-left:0}
}
</style>
</head>

<body>

<div class="board">

<header class="header">

    <div class="brand">
        <img src="/display/mabon-logo.png" alt="Mabon Limited">
        <div class="brand-divider"></div>
    </div>

    <div class="title">
        <h1>DADINKOWA HPP</h1>
        <div class="subtitle">REAL TIME GENERATION BOARD</div>
    </div>

    <div class="clock">
        <div class="clock-title">DATE &amp; TIME</div>
        <div class="clock-date" id="clockDate">--/--/----</div>
        <div class="clock-time" id="clockTime">--:--:--</div>
    </div>

</header>


<section class="unit-section">

    <div class="section-title">UNIT GENERATION (MW)</div>

    <div class="units">

        <div class="unit">
            <div class="unit-name">UNIT 1</div>
            <div class="unit-value-box">
                <div class="unit-value">
                    <span id="unit1Power">--.-</span>
                    <span class="mw">MW</span>
                </div>
            </div>
        </div>

        <div class="unit">
            <div class="unit-name">UNIT 2</div>
            <div class="unit-value-box">
                <div class="unit-value">
                    <span id="unit2Power">--.-</span>
                    <span class="mw">MW</span>
                </div>
            </div>
        </div>

    </div>
</section>


<section class="summary">

    <div class="summary-card">
        <div class="summary-label">TOTAL PLANT GENERATION (MW)</div>
        <div class="summary-value">
            <span id="totalPower">--.-</span>
            <span class="summary-unit">MW</span>
        </div>
    </div>

    <div class="summary-card">
        <div class="summary-label">% CAPACITY UTILIZATION</div>
        <div class="summary-value">
            <span id="capacityPercent">--.-</span>%
        </div>
    </div>

</section>


<section class="metrics">

    <div class="metric">
        <div class="metric-label">TOTAL INSTALLED CAPACITY</div>
        <div class="metric-value">40.0 MW</div>

        <div class="dam-icon">
            <div class="top"></div>
            <div class="body"></div>
            <div class="water"></div>
        </div>
    </div>


    <div class="metric">
        <div class="metric-label">GRID FREQUENCY</div>
        <div class="metric-value">
            <span id="frequency">--.--</span> Hz
        </div>

        <div class="frequency-icon" aria-label="Frequency indicator">
            <span></span><span></span><span></span><span></span>
            <span></span><span></span><span></span>
        </div>
    </div>


    <div class="metric">
        <div class="metric-label">GRID VOLTAGE</div>
        <div class="metric-value">
            <span id="voltage">---.-</span> kV
        </div>

        <div class="voltage-icon" aria-label="Grid voltage indicator">
            <div class="circle"></div>
            <div class="line1"></div>
            <div class="line2"></div>
            <div class="line3"></div>
        </div>
    </div>


    <div class="metric">
        <div class="metric-label">PLANT STATUS</div>

        <div id="plantStatus" class="status normal">CONNECTING</div>

        <div id="statusIcon" class="status-icon" style="color:#3ea63f"></div>
    </div>

</section>


<footer class="footer">

    <div class="footer-item footer-online" id="systemStatus">
        <span style="font-size:2em">♢</span>
        <span>CONNECTING TO RTD</span>
    </div>

    <div class="footer-item">
        <span style="font-size:1.7em">⚡</span>
        <span>RELIABLE POWER</span>
    </div>

    <div class="footer-item">
        <span style="font-size:1.7em">♧</span>
        <span>SUSTAINABLE ENERGY</span>
    </div>

</footer>

</div>


<div id="offlineBanner" class="offline-banner">

    <div class="offline-card">
        <h2>COMMUNICATION LOST</h2>
        <p>RTD telemetry has not been received within the expected interval.</p>
        <p>Last update: <strong id="offlineLastUpdate">--</strong></p>
    </div>

</div>


<script>

const API_URL = "/api/telemetry";
const INSTALLED_CAPACITY_MW = 40.0;

function setText(id,value){
    const el=document.getElementById(id);
    if(el) el.textContent=value;
}

function updateClock(){

    const now=new Date();

    setText(
        "clockDate",
        now.toLocaleDateString("en-GB",{
            day:"2-digit",
            month:"2-digit",
            year:"numeric"
        })
    );

    setText(
        "clockTime",
        now.toLocaleTimeString("en-US",{
            hour:"numeric",
            minute:"2-digit",
            second:"2-digit",
            hour12:true
        })
    );
}

function updatePlantStatus(values){

    const status=document.getElementById("plantStatus");
    const icon=document.getElementById("statusIcon");

    const u1=String(values.UNIT1_STATUS||"").toLowerCase();
    const u2=String(values.UNIT2_STATUS||"").toLowerCase();

    const p1=Number(values.UNIT1_ACTIVE_POWER_MW||0);
    const p2=Number(values.UNIT2_ACTIVE_POWER_MW||0);

    status.className="status";

    if(u1==="generating" || u2==="generating" || p1>0 || p2>0){

        status.textContent="NORMAL";
        status.classList.add("normal");
        icon.style.color="#3ea63f";

    }else{

        status.textContent="SHUTDOWN";
        status.classList.add("danger");
        icon.style.color="#d92b2b";
    }
}

function setOnline(){

    const el=document.getElementById("systemStatus");

    el.className="footer-item footer-online";

    el.innerHTML=
        '<span style="font-size:2em">♢</span>'+
        '<span>ALL SYSTEMS OPERATIONAL</span>';
}

function showOffline(){

    document.getElementById("offlineBanner").classList.add("visible");

    const el=document.getElementById("systemStatus");

    el.className="footer-item footer-alert";

    el.innerHTML=
        '<span style="font-size:2em">!</span>'+
        '<span>COMMUNICATION LOST</span>';
}

function hideOffline(){

    document.getElementById("offlineBanner").classList.remove("visible");
    setOnline();
}

async function updateDashboard(){

    try{

        const response=await fetch(
            API_URL+"?t="+Date.now(),
            {cache:"no-store"}
        );

        if(!response.ok){
            throw new Error("HTTP "+response.status);
        }

        const data=await response.json();

        if(!data.values){
            throw new Error("Telemetry values missing");
        }

        const v=data.values;

        const u1=Number(v.UNIT1_ACTIVE_POWER_MW);
        const u2=Number(v.UNIT2_ACTIVE_POWER_MW);
        const total=Number(v.TOTAL_ACTIVE_POWER_MW);
        const freq=Number(v.GRID_FREQUENCY_HZ);
        const volt=Number(v.GRID_VOLTAGE_KV);

        setText(
            "unit1Power",
            Number.isFinite(u1)?u1.toFixed(1):"--.-"
        );

        setText(
            "unit2Power",
            Number.isFinite(u2)?u2.toFixed(1):"--.-"
        );

        setText(
            "totalPower",
            Number.isFinite(total)?total.toFixed(1):"--.-"
        );

        const utilization=(total/INSTALLED_CAPACITY_MW)*100;

        setText(
            "capacityPercent",
            Number.isFinite(utilization)
                ? utilization.toFixed(1)
                : "--.-"
        );

        setText(
            "frequency",
            Number.isFinite(freq)?freq.toFixed(2):"--.--"
        );

        setText(
            "voltage",
            Number.isFinite(volt)?volt.toFixed(1):"---.-"
        );

        updatePlantStatus(v);
        hideOffline();

    }catch(error){

        console.error("RTD update failed:",error);
        showOffline();
    }
}

updateClock();
setInterval(updateClock,1000);

updateDashboard();
setInterval(updateDashboard,2000);

</script>

</body>
</html>
